      {
        "selector": "JSXOpeningElement[name.name='ChoiceOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|on|muted|key|ref|className|style|children)$/]",
        "message": "<ChoiceOption> doesn't accept that prop. Declared props: label, on, muted."
