{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/surfaces/**",
              "ui_kits/app/**",
              "ui_kits/respond/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Sans|Playfair Display|Orgpuls Cyrillic|Bricolage Grotesque|DM Sans Fallback|Playfair Display Fallback))/i]",
        "message": "Font not provided by the design system. Available: DM Sans, Playfair Display, Orgpuls Cyrillic, Bricolage Grotesque, DM Sans Fallback, Playfair Display Fallback."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccountChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|active|size|label|key|ref|className|style|children)$/]",
        "message": "<AccountChip> doesn't accept that prop. Declared props: initials, active, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|pad|href|disabled|block|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: size, tone, pad, href, disabled, block, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|panel|sm|xs|act|xxs|tiny)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'panel' | 'sm' | 'xs' | 'act' | 'xxs' | 'tiny'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|quiet|solid|ghost|danger)$/]",
        "message": "<Button> tone must be one of 'primary' | 'secondary' | 'quiet' | 'solid' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|tone|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: as, tone, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:div|section|article|a)$/]",
        "message": "<Card> as must be one of 'div' | 'section' | 'article' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|accent|mint|ink|inset)$/]",
        "message": "<Card> tone must be one of 'surface' | 'accent' | 'mint' | 'ink' | 'inset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|label|note|checked|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<CheckCard> doesn't accept that prop. Declared props: name, value, label, note, checked, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|sub|checked|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<CheckRow> doesn't accept that prop. Declared props: name, label, sub, checked, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|name|value|label|checked|disabled|height|padding|fontSize|onChange|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: type, name, value, label, checked, disabled, height, padding, fontSize, onChange, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:radio|checkbox)$/]",
        "message": "<Chip> type must be one of 'radio' | 'checkbox'."
